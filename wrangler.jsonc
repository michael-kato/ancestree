{
  "name": "ancestree",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "ancestree", "database_id": "f2ba9ec8-b346-4997-bcc1-398884a1b257" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ancestree-media" }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Sender on a domain onboarded to Cloudflare Email Sending.
    "MAIL_FROM": "login@example.com",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFeli-0DYiOidWtc"
  },
  "observability": { "enabled": true }
}
