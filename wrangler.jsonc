{
  "name": "ancestree",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "ancestree.michaelkato.work", "custom_domain": true }],
  "workers_dev": true, // keep the old address working
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "ancestree-db", "database_id": "cf24e98f-0728-4347-a4a1-0e8e50672754" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ancestree-media" }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Sender on a domain onboarded to Cloudflare Email Sending.
    "MAIL_FROM": "ancestree@michaelkato.work",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFeli-0DYiOidWtc"
  },
  "observability": { "enabled": true }
}
